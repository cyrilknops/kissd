# --- admin login -----------------------------------------------------------
KISSD_ADMIN_USER=admin
KISSD_ADMIN_PASSWORD=change-me

# Signs session cookies. Generate one with: openssl rand -hex 32
KISSD_JWT_SECRET=

# --- ntfy (first-run bootstrap only) ---------------------------------------
# These seed the settings file the first time kissd starts. After that, manage
# ntfy from Settings -> Notifications in the UI; edits there win.
# Leave blank to start with alerts disabled and configure entirely in the UI.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# --- image -----------------------------------------------------------------
# Which cyrilknops/kissd tag to run. "latest" moves with every merge to main;
# pin a specific build with sha-<commit> if you would rather upgrade by hand.
# Set it to a tag you built yourself to run a local image instead.
KISSD_TAG=latest

# --- host wiring -----------------------------------------------------------
# Where your docker-compose files live. Bind-mounted at the same path inside
# the container so `docker compose` resolves relative bind mounts correctly.
REPO_DIR=/srv/docker

# Name used in alert titles.
HOSTNAME_FQDN=my-server
